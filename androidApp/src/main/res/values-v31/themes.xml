<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash screen theme for Android 12+ (API 31+) -->
    <style name="Theme.Caliq.Splash" parent="Theme.Caliq">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">#1C5B7D</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">1</item>
        <item name="postSplashScreenTheme">@style/Theme.Caliq</item>
    </style>
</resources>
